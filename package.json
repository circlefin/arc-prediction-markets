    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.47.5",
    "wagmi": "^3.5.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.1.0",
